---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import { linkConsulta } from '../utils/whatsapp';
import { faqJsonLd, breadcrumbJsonLd } from '../utils/seo';

const faqs = [
  {
    pregunta: '¿Los perfumes son originales?',
    respuesta:
      'Sí, siempre. Cada decant se hace directamente del frasco original de la marca. No trabajamos con imitaciones ni con perfumes "inspirados en".',
  },
  {
    pregunta: '¿Cuánto dura un decant de 5 ml?',
    respuesta:
      'Depende de cuánto te apliques, pero en promedio un decant de 5 ml rinde entre 25 y 40 aplicaciones, suficiente para dos o tres semanas de uso regular.',
  },
  {
    pregunta: '¿Cómo se hace la entrega?',
    respuesta:
      'Coordinamos la entrega directamente por WhatsApp una vez confirmado tu pedido, dentro de Pachuca de Soto, Hidalgo.',
  },
  {
    pregunta: '¿Se puede pagar por transferencia?',
    respuesta:
      'Sí. Al escribirnos por WhatsApp te confirmamos los métodos de pago disponibles para tu pedido.',
  },
];

const jsonLd = [
  faqJsonLd(faqs),
  breadcrumbJsonLd([
    { name: 'Inicio', url: '/' },
    { name: 'Qué es un decant', url: '/que-es-un-decant' },
  ]),
];
---

<BaseLayout
  title="Qué es un decant de perfume y cómo se hace | Decanto Selecto"
  description="Te explicamos paso a paso cómo hacemos cada decant a partir del frasco original: medición exacta, envasado nuevo y por qué la originalidad no se negocia."
  jsonLd={jsonLd}
>
  <section class="bg-ink px-4 py-16 text-center md:px-6">
    <div class="mx-auto max-w-2xl">
      <h1 class="font-display text-4xl font-semibold text-bone md:text-5xl">Qué es un decant</h1>
      <p class="mt-4 text-neutral-300">
        Una porción del perfume original, medida con precisión y envasada en un atomizador nuevo. Nada más.
      </p>
    </div>
  </section>

  <section class="px-4 py-16 md:px-6">
    <div class="mx-auto max-w-3xl">
      <SectionHeading titulo="El proceso, paso a paso" align="left" />

      <div class="space-y-8">
        <div class="flex gap-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gold-wash font-display text-xl font-semibold text-ink">
            1
          </span>
          <div>
            <h3 class="font-display text-xl font-semibold text-ink">Partimos del frasco original</h3>
            <p class="mt-2 text-neutral-600">
              Cada decant sale de un frasco de la marca, comprado y verificado como original. No existe un decant
              sin ese punto de partida — si el frasco de origen no es auténtico, tampoco lo es lo que sale de él.
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gold-wash font-display text-xl font-semibold text-ink">
            2
          </span>
          <div>
            <h3 class="font-display text-xl font-semibold text-ink">Medimos la cantidad exacta</h3>
            <p class="mt-2 text-neutral-600">
              Usamos instrumentos de medición limpios, exclusivos para esta tarea, para transferir exactamente los
              5 o 10 ml que pediste. Sin diluir con alcohol adicional, sin mezclar con ningún otro producto.
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gold-wash font-display text-xl font-semibold text-ink">
            3
          </span>
          <div>
            <h3 class="font-display text-xl font-semibold text-ink">Envasamos en un atomizador nuevo</h3>
            <p class="mt-2 text-neutral-600">
              Cada pedido se envasa en un atomizador nuevo, sin residuos de ningún otro perfume. Lo que huelas es
              exclusivamente la fragancia que elegiste, lista para usarse desde el primer día.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-14 rounded-lg bg-gold-wash p-8">
        <h2 class="font-display text-2xl font-semibold text-ink">Por qué la originalidad no se negocia</h2>
        <p class="mt-3 text-neutral-700">
          Un decant hecho a partir de un perfume falsificado no solo huele distinto: los aceites y fijadores de una
          imitación casi nunca logran la misma complejidad, y su composición no está pensada para el mismo contacto
          prolongado con la piel. Por eso, en Decanto Selecto, el frasco de origen siempre es 100% original —
          sin excepciones, y sin importar la fragancia que pidas.
        </p>
      </div>

      <div class="mt-16">
        <SectionHeading titulo="Preguntas frecuentes" align="left" />
        <div class="space-y-6">
          {
            faqs.map((faq) => (
              <div class="border-b border-neutral-200 pb-6">
                <h3 class="font-display text-lg font-semibold text-ink">{faq.pregunta}</h3>
                <p class="mt-2 text-neutral-600">{faq.respuesta}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-14 text-center">
        <p class="font-display text-2xl font-semibold text-ink">¿Sigues con dudas?</p>
        <p class="mt-2 text-neutral-500">Escríbenos y te explicamos con calma.</p>
        <Button href={linkConsulta('el proceso de decantado')} target="_blank" rel="noopener noreferrer" class="mt-5">
          Escribir por WhatsApp →
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
