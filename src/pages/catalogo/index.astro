---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterBar from '../../components/product/FilterBar.astro';
import ProductGrid from '../../components/product/ProductGrid.astro';
import { linkConsulta } from '../../utils/whatsapp';
import { perfumes } from '../../data/perfumes';
import { breadcrumbJsonLd } from '../../utils/seo';

const jsonLd = breadcrumbJsonLd([
  { name: 'Inicio', url: '/' },
  { name: 'Catálogo', url: '/catalogo' },
]);
---

<BaseLayout
  title="Catálogo de decants de perfume en Pachuca | Decanto Selecto"
  description="Explora las microfragancias originales de Decanto Selecto. Filtra por ocasión, clima y precio, o busca por nombre y marca. Entrega en Pachuca."
  jsonLd={jsonLd}
>
  <section class="px-4 py-12 md:px-6">
    <div class="mx-auto max-w-6xl">
      <header class="mb-8 text-center">
        <h1 class="font-display text-4xl font-semibold text-ink md:text-5xl">Catálogo</h1>
        <p class="mt-3 text-neutral-500">{perfumes.length} microfragancias originales · 5 y 10 ml</p>
      </header>

      <div class="mb-10">
        <FilterBar />
      </div>

      <p id="resultado-contador" class="mb-6 text-sm font-medium text-neutral-500" aria-live="polite">
        Mostrando {perfumes.length} fragancias
      </p>

      <ProductGrid perfumes={perfumes} id="catalogo-grid" />

      <div id="catalogo-vacio" class="hidden rounded-lg border border-neutral-200 bg-white p-10 text-center">
        <p class="text-lg font-medium text-ink">No encontramos una fragancia con esos filtros.</p>
        <p class="mt-2 text-neutral-500">Escríbenos y con gusto te decimos si la tenemos o la conseguimos.</p>
        <a
          id="catalogo-vacio-whatsapp"
          href={linkConsulta()}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-md bg-gold px-6 py-3 text-sm font-semibold text-ink hover:bg-gold-deep"
        >
          Preguntar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
