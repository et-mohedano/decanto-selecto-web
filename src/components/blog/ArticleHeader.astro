---
interface Props {
  categoria: string;
  titulo: string;
  fecha: Date;
  minutosLectura?: number;
}

const { categoria, titulo, fecha, minutosLectura = 6 } = Astro.props;
const fechaFormateada = fecha.toLocaleDateString('es-MX', { year: 'numeric', month: 'long' });
---

<header class="mx-auto max-w-3xl px-4 pb-8 pt-14 text-center md:px-0">
  <span class="text-xs font-semibold uppercase tracking-widest text-neutral-500">{categoria}</span>
  <h1 class="mt-3 font-display text-4xl font-semibold text-ink md:text-5xl">{titulo}</h1>
  <p class="mt-4 text-sm text-neutral-500">{fechaFormateada} · {minutosLectura} min de lectura</p>
</header>
