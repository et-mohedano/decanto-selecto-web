---
import { getPerfumes } from '../../data/perfumes';
import { optimizedProductImage } from '../../utils/images';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const perfumes = await getPerfumes();
const perfume = perfumes.find((p) => p.slug === slug);
if (!perfume) throw new Error(`InlineProduct: no existe el perfume "${slug}"`);

const precio5 = perfume.tamanos.find((t) => t.ml === 5);
const imagen = await optimizedProductImage(perfume.imagen, 128);
---

<a
  href={`/perfume/${perfume.slug}`}
  class="my-6 flex items-center gap-4 rounded-lg border border-gold-pale bg-gold-wash p-4 no-underline transition-shadow hover:shadow-md"
>
  <span class="flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full border-2 border-gold bg-white">
    <img
      src={imagen.src}
      alt={`Frasco de ${perfume.nombre} de ${perfume.marca}`}
      loading="lazy"
      width="64"
      height="64"
      class="h-full w-full object-cover"
    />
  </span>
  <span class="flex-1">
    <span class="marca-versalitas block text-xs text-neutral-500">{perfume.marca}</span>
    <span class="block font-display text-lg font-semibold text-ink">{perfume.nombre}</span>
    <span class="block text-sm text-neutral-600">Desde ${precio5?.precio} — 5 ml</span>
  </span>
  <span class="shrink-0 rounded-md bg-gold px-4 py-2 text-sm font-semibold text-ink">Ver →</span>
</a>
