---
import type { Perfume } from '../../data/perfumes';
import { optimizedProductImage } from '../../utils/images';

interface Props {
  perfume: Perfume;
}

const { perfume } = Astro.props;
const precio5 = perfume.tamanos.find((t) => t.ml === 5);
const precio10 = perfume.tamanos.find((t) => t.ml === 10);
const imagen = await optimizedProductImage(perfume.imagen, 256);

// Atributos data-* usados por el script de filtrado de /catalogo (ver FilterBar.astro)
const dataOcasiones = perfume.ocasiones.join(',');
const dataTexto = `${perfume.nombre} ${perfume.marca}`.toLowerCase();
---

<a
  href={`/perfume/${perfume.slug}`}
  data-product-card
  data-ocasiones={dataOcasiones}
  data-clima={perfume.clima}
  data-precio10={precio10?.precio}
  data-texto={dataTexto}
  class="group flex flex-col items-center rounded-lg border border-neutral-200 bg-white p-5 text-center transition-shadow hover:shadow-md"
>
  <span class="mb-4 flex h-32 w-32 items-center justify-center overflow-hidden rounded-full border-[3px] border-gold bg-neutral-100">
    <img
      src={imagen.src}
      alt={`Frasco de ${perfume.nombre} de ${perfume.marca} junto a decant de Decanto Selecto`}
      loading="lazy"
      width="128"
      height="128"
      class="h-full w-full object-cover"
    />
  </span>
  <span class="marca-versalitas text-xs text-neutral-500">{perfume.marca}</span>
  <h3 class="mt-1 font-display text-xl font-semibold text-ink">{perfume.nombre}</h3>
  <p class="mt-1 text-sm text-neutral-500">{perfume.descripcionCorta}</p>
  <p class="mt-3 font-body text-base font-semibold text-ink">
    5&nbsp;ml ${precio5?.precio} · 10&nbsp;ml ${precio10?.precio}
  </p>
  <span class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-md bg-gold px-4 py-2 text-sm font-medium text-ink transition-colors group-hover:bg-gold-deep">
    Ver y pedir
  </span>
</a>
